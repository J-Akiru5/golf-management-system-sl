NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the scorecard document store and the tabulation role script. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Some Vercel projects store the same key under this name; the app accepts either.
SUPABASE_SECRET_ROLE_KEY=
# The deployed domain used in player-facing share links, for example https://golf.syntaxure.dev.
# Without it, links are built from the current origin, which is localhost during development.
NEXT_PUBLIC_SITE_URL=

# Media and document storage (Cloudflare R2, S3-compatible API). Server-side only.
# The same bucket can hold scorecard scans, event logos, course maps and generated documents.
R2_ACCOUNT_ID=
# R2 API token credentials with Object Read & Write on the bucket. Never expose these to a browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name, not a URL or the account id.
R2_BUCKET=
# Optional S3 endpoint override. Defaults to https://<account>.r2.cloudflarestorage.com.
R2_ENDPOINT=
# Optional public custom domain for objects explicitly marked public. Leave empty to keep every read
# signed. The bucket itself stays private.
R2_PUBLIC_URL=

# Optional card-reader service. It receives a multipart image, mode and template, and returns
# players[].holes[].strokes/confidence. Leave empty to use the photo with manual entry.
SCAN_INFERENCE_URL=
SCAN_INFERENCE_TOKEN=

# Optional email delivery. Without these, reminders are queued but never claimed as sent.
RESEND_API_KEY=
EMAIL_FROM=

# Scorecard tabulation area. The document lives in this private Supabase Storage bucket, and only
# accounts with the tabulation app metadata role (or these emails) may read or write it.
SCORECARD_BUCKET=scorecard-documents
SCORECARD_TABULATION_EMAILS=
# Local development only. Never set this on Vercel.
# SCORECARD_AUTH=off
