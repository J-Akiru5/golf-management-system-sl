# Set to 1 to serve the workspace app. Unset, or any other value, returns 404 for every route.
OPS_ENABLED=

# Set to 1 to run on in-memory demo data. Ignored in a production build, and ignored when
# NEXT_PUBLIC_SUPABASE_URL is set. Demo mode needs no database.
OPS_DEMO=

# The shared Supabase project URL. The workspace tables live in the same project as the desk.
NEXT_PUBLIC_SUPABASE_URL=

# The project's anon key. It is public by design: row level security is the protection. Every read
# and every role change runs as the signed-in owner through the user's own session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by the Admin page for the two Auth admin actions that the anon key cannot do:
# sending an email invitation and setting the `scorecard_role` app metadata (tabulator access).
# It is read only inside a server action, after the caller is confirmed as an active workspace
# owner, and it must never be a NEXT_PUBLIC_ value or appear in a client component.
# Without it, Invite and the Tabulator control show "Needs the service-role key on this project";
# every other Admin action keeps working through the owner-gated database functions.
# SUPABASE_SECRET_ROLE_KEY is accepted as an alias for the same value.
SUPABASE_SERVICE_ROLE_KEY=
