{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "apps/**",
      "packages/**",
      "*.json",
      "*.ts",
      "!**/node_modules/**",
      "!**/.next/**",
      "!**/seed/out/**",
      "!.claude/**",
      "!.worktrees/**",
      "!.watch-staging/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto"
  },
  "overrides": [
    {
      "includes": ["apps/ops/src/lib/db/**", "apps/ops/scripts/workspace-rls.mjs"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
